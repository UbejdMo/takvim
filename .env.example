# ---- PostgreSQL ----
POSTGRES_USER=takvimi
POSTGRES_PASSWORD=change_me_in_prod
POSTGRES_DB=takvimi
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Async SQLAlchemy URL (used by the backend app).
# For local (non-docker) runs use POSTGRES_HOST=localhost.
DATABASE_URL=postgresql+asyncpg://takvimi:change_me_in_prod@db:5432/takvimi

# ---- Backend ----
# Comma-separated list of allowed CORS origins for the frontend.
CORS_ORIGINS=http://localhost:5173,http://localhost:4173
# The timezone all "today / now" logic is anchored to (do not change).
APP_TIMEZONE=Europe/Belgrade
# Default city slug shown on first load.
DEFAULT_CITY=prishtine

# ---- Frontend ----
# Base URL the browser uses to reach the API.
VITE_API_BASE_URL=http://localhost:8000/api
